{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "博客 CMS",
  "version": "1.0.9",
  "identifier": "xyz.544688.hugo-cms",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "博客 CMS",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 670
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-src http://127.0.0.1:*; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-src http://127.0.0.1:*; connect-src ipc: http://ipc.localhost ws://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": true,
    "shortDescription": "Hugo 博客写作客户端",
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/hugo"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    },
    "resources": [
      "licenses/*"
    ]
  }
}
